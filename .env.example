GITHUB_TOKEN=ghp_...
GITHUB_HANDLE=MaheshBhushan
DISCORD_TOKEN=...
# Only needed if --register cannot derive it from the token
#DISCORD_APP_ID=...
DISCORD_CHANNEL_ID=...
RADAR_DB=/home/maheshk/issue-radar/radar.db
# Optional
RADAR_LABELS=bug,good first issue
RADAR_STALE_DAYS=30
# How far back /watch seeds on registration
RADAR_BACKFILL_DAYS=90
RADAR_DIGEST_THRESHOLD=5
RADAR_RATE_FLOOR=500
# Discord user id to ping on race warnings and merges; omit for @here
#RADAR_PING=123456789012345678

# Only announce issues carrying a watched label (huge repos)
#RADAR_ONLY_LABELLED=true
# Skip issues that already have a PR attached
#RADAR_ONLY_UNCLAIMED=true

# Max issue timelines resolved per repo per cycle
#RADAR_LINK_BUDGET=60

# An issue opened longer ago than this is never announced as new, no matter how
# recently we first saw it. Closures and reopens on it still come through.
#RADAR_MAX_ISSUE_AGE_HOURS=24

# Required: Discord user ids allowed to run slash commands (comma-separated).
# Unset means every command is refused.
DISCORD_ALLOWED_USER_IDS=
# Optional: only accept commands from this server / these channels
DISCORD_GUILD_ID=
DISCORD_COMMAND_CHANNEL_IDS=

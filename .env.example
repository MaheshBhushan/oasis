GITHUB_TOKEN=ghp_...
GITHUB_HANDLE=MaheshBhushan
DISCORD_TOKEN=...
# Only needed if --register cannot derive it from the token
#DISCORD_APP_ID=...
DISCORD_CHANNEL_ID=...
RADAR_DB=/home/maheshk/issue-radar/radar.db
# Optional
RADAR_LABELS=bug,good first issue
RADAR_STALE_DAYS=30
# How far back /watch seeds on registration
RADAR_BACKFILL_DAYS=90
RADAR_DIGEST_THRESHOLD=5
RADAR_RATE_FLOOR=500
